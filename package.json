{
  "name": "palomo",
  "productName": "Palomo API-geon",
  "version": "0.1.0",
  "description": "Palomo API-geon, para probar APIs",
  "desktopName": "palomo.desktop",
  "homepage": "https://github.com/tonyponyy/palomo",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "predist": "node scripts/sincronizar_version.js",
    "dist": "electron-builder --linux",
    "preappimage": "node scripts/sincronizar_version.js",
    "appimage": "electron-builder --linux AppImage",
    "prewin": "node scripts/sincronizar_version.js",
    "win": "electron-builder --win nsis zip"
  },
  "author": {
    "name": "Antoni Andreu",
    "email": "antoniandreut@gmail.com"
  },
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tonypony.palomo",
    "productName": "Palomo API-geon",
    "files": [
      "src/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Palomo-API-geon-${version}.AppImage"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Palomo-API-geon-${version}-windows-portable.${ext}"
    },
    "nsis": {
      "artifactName": "Palomo-API-geon-${version}-instalador.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
